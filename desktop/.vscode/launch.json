{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Main (Electron)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
      "runtimeArgs": ["--remote-debugging-port=9222", "."],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "sourceMaps": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Renderer (attach)",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}/renderer",
      "urlFilter": "app://*"
    }
  ],
  "compounds": [
    {
      "name": "Electron: main + renderer",
      "configurations": ["Main (Electron)", "Renderer (attach)"]
    }
  ]
}
