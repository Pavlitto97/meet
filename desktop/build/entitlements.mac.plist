<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements для підписаного/нотаризованого macOS-білду (Hardened Runtime).
  Electron (V8) потребує JIT і завантаження бібліотек поза bundle (sharp .node).
  Поки збірка unsigned (identity: null) — цей файл НЕ застосовується (крок codesign
  пропускається). Активується автоматично, коли додати Developer ID (див.
  electron-builder.yml, блок `mac`).
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
</dict>
</plist>
