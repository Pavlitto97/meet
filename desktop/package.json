{
  "name": "meet-editor-desktop",
  "version": "0.1.8",
  "description": "Meet editor — Electron rewrite (Windows + macOS, auto-update, local data)",
  "author": "Pavel Hrinevych",
  "license": "UNLICENSED",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.json",
    "build:renderer": "vite build renderer",
    "build": "npm run build:renderer && npm run build:main",
    "start": "npm run build && electron .",
    "debug": "npm run build && electron --inspect=9229 --remote-debugging-port=9222 .",
    "dev": "tsc -w -p tsconfig.json",
    "dev:renderer": "vite build renderer --watch",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "publish": "npm run build && electron-builder --publish always",
    "test:e2e": "npm run build && playwright test",
    "postinstall": "node scripts/ensure-electron.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/tsconfig": "^0.9.1",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "electron-devtools-installer": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vue-tsc": "^2.2.12"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.3",
    "flatpickr": "^4.6.13",
    "pinia": "^2.3.1",
    "sharp": "^0.34.5",
    "vue": "^3.5.35",
    "vue-router": "^4.6.4"
  }
}
